{
  "name": "signify-creator",
  "private": true,
  "version": "1.1.0",
  "description": "Self-hosted multi-tenant email-signature SaaS for Node.js.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ithealthtech/Signify-Suite.git"
  },
  "bugs": {
    "url": "https://github.com/ithealthtech/Signify-Suite/issues"
  },
  "homepage": "https://github.com/ithealthtech/Signify-Suite#readme",
  "packageManager": "npm@11.6.2",
  "type": "commonjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env.local server.cjs",
    "worker": "node --env-file-if-exists=.env.local worker.cjs",
    "media:migrate": "node --env-file-if-exists=.env.local scripts/migrate-media-to-s3.cjs",
    "postgres:migrate": "node --env-file-if-exists=.env.local scripts/postgres-migrate.cjs",
    "postgres:import": "node --env-file-if-exists=.env.local scripts/postgres-import.cjs",
    "postgres:test": "node --env-file-if-exists=.env.local scripts/postgres-test.cjs",
    "migrate": "node --env-file-if-exists=.env.local scripts/migrate.cjs",
    "doctor": "node --env-file-if-exists=.env.local scripts/doctor.cjs",
    "setup": "node scripts/setup.cjs",
    "dev": "node scripts/dev.cjs",
    "build": "node scripts/build.cjs",
    "typecheck": "node --check server.cjs && node --check worker.cjs && node --check server/config.cjs && node --check server/licensing.cjs && node --check server/readiness.cjs && node --check server/transactional-email.cjs && node --check server/provider-acceptance.cjs",
    "benchmark": "node scripts/benchmark.cjs",
    "test": "node scripts/version-test.cjs && node scripts/unit-test.cjs && node scripts/frontend-test.cjs && node scripts/database-test.cjs && node scripts/licensing-test.cjs && node scripts/release-signature-test.cjs && node scripts/runtime-lease-test.cjs && node scripts/postgres-test.cjs && node scripts/postgres-import-test.cjs && node scripts/credential-rotation-test.cjs && node scripts/deployment-test.cjs && node scripts/container-test.cjs && node scripts/job-test.cjs && node scripts/email-test.cjs && node scripts/provider-acceptance-test.cjs && node scripts/media-test.cjs && node scripts/observability-test.cjs && node scripts/operations-test.cjs && node scripts/recovery-test.cjs && node scripts/security-test.cjs && node scripts/setup-test.cjs && node scripts/installer-test.cjs && node scripts/smoke-test.cjs",
    "test:version": "node scripts/version-test.cjs",
    "test:unit": "node scripts/unit-test.cjs",
    "test:frontend": "node scripts/frontend-test.cjs",
    "test:pages": "node scripts/pages-test.cjs",
    "test:database": "node scripts/database-test.cjs",
    "test:licensing": "node scripts/licensing-test.cjs",
    "test:release-signature": "node scripts/release-signature-test.cjs",
    "test:runtime-lease": "node scripts/runtime-lease-test.cjs",
    "test:deployment": "node scripts/deployment-test.cjs",
    "test:container": "node scripts/container-test.cjs",
    "test:jobs": "node scripts/job-test.cjs",
    "test:email": "node scripts/email-test.cjs",
    "test:providers": "node scripts/provider-acceptance-test.cjs",
    "test:media": "node scripts/media-test.cjs",
    "test:observability": "node scripts/observability-test.cjs",
    "test:operations": "node scripts/operations-test.cjs",
    "test:recovery": "node scripts/recovery-test.cjs",
    "test:security": "node scripts/security-test.cjs && node scripts/secret-scan.cjs",
    "test:artifact-startup": "node scripts/artifact-startup-test.cjs",
    "test:setup": "node scripts/setup-test.cjs",
    "test:installer": "node scripts/installer-test.cjs",
    "test:smoke": "node scripts/smoke-test.cjs",
    "test:sbom": "npm run sbom && node scripts/sbom-test.cjs",
    "sbom": "node scripts/generate-sbom.cjs",
    "smoke": "node scripts/smoke-test.cjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:security && npm test && npm run test:sbom && npm run build && node scripts/artifact-test.cjs && npm run test:artifact-startup",
    "backup": "node --env-file-if-exists=.env.local scripts/backup.cjs",
    "recovery:drill": "node --env-file-if-exists=.env.local scripts/recovery-drill.cjs",
    "deploy:release": "node --env-file-if-exists=.env.local scripts/deploy-release.cjs",
    "demo:seed": "node --env-file-if-exists=.env.local scripts/seed-demo-team.cjs",
    "signature:reset-admin": "node --env-file-if-exists=.env.local scripts/reset-signature-admin.cjs",
    "application:grant-owner": "node --env-file-if-exists=.env.local scripts/grant-application-owner.cjs",
    "credentials:rotate": "node --env-file-if-exists=.env.local scripts/rotate-integration-credentials.cjs",
    "security:access-review": "node --env-file-if-exists=.env.local scripts/access-review.cjs",
    "integrations:verify": "node --env-file-if-exists=.env.local scripts/verify-provider-integrations.cjs",
    "integrations:accept": "node --env-file-if-exists=.env.local scripts/verify-provider-integrations.cjs --exercise"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "gifenc": "^1.0.3",
    "otpauth": "^9.5.1",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.4",
    "stripe": "^22.6.0",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "eslint": "^10.8.0",
    "prettier": "^3.9.6"
  }
}
