NODE_ENV=production
HOST=127.0.0.1
PORT=4173
TRUST_PROXY=false
LOG_LEVEL=info
DATABASE_PATH=./data/signify-creator.db
BACKUP_DIR=./backups
SIGNATURE_SESSION_HOURS=12
SIGNATURE_ALLOW_DEFAULT_ADMIN=false
SIGNIFY_BOOTSTRAP_EMAIL=owner@example.com
SIGNIFY_BOOTSTRAP_PASSWORD=replace-with-a-strong-password
SIGNIFY_APPLICATION_OWNER_EMAIL=owner@example.com
SIGNIFY_COMPANY_NAME=Example Company
SIGNIFY_PUBLIC_URL=https://signatures.example.com
SIGNIFY_ASSET_BASE_URL=https://signatures.example.com
SIGNIFY_MEDIA_BASE_URL=https://signatures.example.com
SIGNIFY_ALLOW_REGISTRATION=false
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
SIGNIFY_CREDENTIAL_ENCRYPTION_KEY=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Optional legacy tenant imported as the first workspace connection.
MICROSOFT_TENANT_ID=
# Optional legacy sender imported into the first workspace connection.
MICROSOFT_SENDER_EMAIL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_BUSINESS=
