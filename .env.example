NODE_ENV=production
HOST=127.0.0.1
PORT=4173
TRUST_PROXY=false
LOG_LEVEL=info
SIGNIFY_SERVICE_NAME=signify-creator
SIGNIFY_ENVIRONMENT=production
# Optional HTTPS collector accepting batched JSON diagnostic events. Keep its
# bearer token in the host secret store, not in source control.
SIGNIFY_OBSERVABILITY_ENDPOINT=
SIGNIFY_OBSERVABILITY_TOKEN=
SIGNIFY_OBSERVABILITY_BATCH_SIZE=100
SIGNIFY_OBSERVABILITY_MAX_BUFFER=1000
SIGNIFY_OBSERVABILITY_FLUSH_MS=5000
SIGNIFY_OBSERVABILITY_TIMEOUT_MS=5000
SIGNIFY_ALERT_MIN_REQUESTS=20
SIGNIFY_ALERT_ERROR_RATE=0.05
SIGNIFY_ALERT_QUEUE_AGE_SECONDS=300
SIGNIFY_ALERT_COOLDOWN_SECONDS=300
# Use embedded for one Node.js process. Use external and run `npm run worker`
# when the host supports a separately supervised worker process.
SIGNIFY_JOB_MODE=embedded
DATABASE_PATH=./data/signify-creator.db
# PostgreSQL migration/acceptance tooling. The web runtime remains on SQLite
# until repository conversion is complete; do not set this as a runtime switch.
DATABASE_URL=
DATABASE_SSL_MODE=verify-full
DATABASE_CA_CERT=
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_APPLICATION_NAME=signify-creator
BACKUP_DIR=./backups
SIGNIFY_MEDIA_STORAGE=local
# For production object storage, set SIGNIFY_MEDIA_STORAGE=s3. Static access
# keys are optional when the host provides an IAM workload identity.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# GitHub owner/repository used by the Application Owner update checker.
SIGNIFY_UPDATE_REPOSITORY=ithealthtech/Signify-Suite
SIGNATURE_SESSION_HOURS=12
SIGNIFY_TENANT_MEDIA_LIMIT_MB=250
SIGNIFY_TENANT_DELETION_GRACE_DAYS=7
SIGNATURE_ALLOW_DEFAULT_ADMIN=false
SIGNIFY_BOOTSTRAP_EMAIL=owner@example.com
SIGNIFY_BOOTSTRAP_PASSWORD=replace-with-a-strong-password
SIGNIFY_APPLICATION_OWNER_EMAIL=owner@example.com
SIGNIFY_COMPANY_NAME=Example Company
SIGNIFY_PUBLIC_URL=https://signatures.example.com
SIGNIFY_ASSET_BASE_URL=https://signatures.example.com
SIGNIFY_MEDIA_BASE_URL=https://signatures.example.com
SIGNIFY_ALLOW_REGISTRATION=false
# Production defaults to true. Owners must enroll before using the control plane.
SIGNIFY_REQUIRE_OWNER_MFA=true
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
SIGNIFY_CREDENTIAL_ENCRYPTION_KEY=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Optional legacy tenant imported as the first workspace connection.
MICROSOFT_TENANT_ID=
# Optional legacy sender imported into the first workspace connection.
MICROSOFT_SENDER_EMAIL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_BUSINESS=
