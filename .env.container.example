# Copy this file to .env.container and replace every required value.
SIGNIFY_IMAGE=ghcr.io/ithealthtech/signify-suite
SIGNIFY_VERSION=0.4.0
SIGNIFY_PORT=4173

SIGNIFY_PUBLIC_URL=https://sigs.example.com
SIGNIFY_ASSET_BASE_URL=https://sigs.example.com
SIGNIFY_MEDIA_BASE_URL=https://sigs.example.com
SIGNIFY_COMPANY_NAME=Example Company
SIGNIFY_APPLICATION_OWNER_EMAIL=owner@example.com
SIGNIFY_BOOTSTRAP_EMAIL=owner@example.com
# Leave blank to let the one-shot setup command generate and print a password.
SIGNIFY_BOOTSTRAP_PASSWORD=
# Required: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
SIGNIFY_CREDENTIAL_ENCRYPTION_KEY=

SIGNIFY_ALLOW_REGISTRATION=false
SIGNIFY_REQUIRE_OWNER_MFA=true
SIGNATURE_SESSION_HOURS=12
SIGNIFY_TENANT_MEDIA_LIMIT_MB=250
SIGNIFY_TENANT_DELETION_GRACE_DAYS=7
LOG_LEVEL=info
SIGNIFY_WORKER_HEARTBEAT_SECONDS=10

SIGNIFY_MEDIA_STORAGE=local
SIGNIFY_BACKUP_STORAGE=local
SIGNIFY_BACKUP_RETENTION_DAYS=30
SIGNIFY_BACKUP_MINIMUM_COPIES=7
SIGNIFY_BACKUP_INCLUDE_LOCAL_MEDIA=true

# Configure providers after MFA enrollment through First-time setup.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_BUSINESS=
